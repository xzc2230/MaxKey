# 复制为 docs/deploy/.env 后填写。文件权限设为 0600，不要提交。

SSO_HOST=sso.tdafadfaww.com
ADMIN_HOST=iam-admin.tdafadfaww.com
CHAT_HOST=chat.tdafadfaww.com
AGENT_HOST=agent.tdafadfaww.com

SSO_PUBLIC_BASE=https://sso.tdafadfaww.com
CHAT_PUBLIC_BASE=https://chat.tdafadfaww.com
AGENT_PUBLIC_BASE=https://agent.tdafadfaww.com
MAXKEY_PUBLIC_ISSUER=https://sso.tdafadfaww.com/sign

# 四个镜像在仓库根目录按下面的 Dockerfile 构建。禁止 latest。
# maxkey-webs/maxkey-web-maxkey/Dockerfile
# maxkey-webs/maxkey-web-mgt/Dockerfile
# maxkey-web-frontend/maxkey-web-ng/Dockerfile
# maxkey-web-frontend/maxkey-web-mgt-ng/Dockerfile
MAXKEY_AUTH_IMAGE=maxkey-auth:4.2.0-d7c9d9af
MAXKEY_MGT_IMAGE=maxkey-mgt:4.2.0-d7c9d9af
MAXKEY_AUTH_WEB_IMAGE=maxkey-auth-web:4.2.0-d7c9d9af
MAXKEY_MGT_WEB_IMAGE=maxkey-mgt-web:4.2.0-d7c9d9af

# 替换成已在测试环境验证过的 Chatwoot 版本。禁止 latest。
CHATWOOT_IMAGE=chatwoot/chatwoot:v4.7.0

MAXKEY_DATABASE_ROOT_PASSWORD=
MAXKEY_DATABASE_PASSWORD=
MAXKEY_REDIS_PASSWORD=
# 两段各自至少 64 字节，再做 base64url 编码。
MAXKEY_JWT_SECRET=
MAXKEY_JWT_REFRESH_SECRET=
MAXKEY_MFA_ENABLED=true
MAXKEY_INST_ID=1

# 在 MaxKey 注册的客服入口客户端。回调必须等于 ${AGENT_PUBLIC_BASE}/callback
MAXKEY_CLIENT_ID=
MAXKEY_CLIENT_SECRET=

CHATWOOT_POSTGRES_PASSWORD=
CHATWOOT_REDIS_PASSWORD=
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_ACTIVE_RECORD_PRIMARY_KEY=
CHATWOOT_ACTIVE_RECORD_DETERMINISTIC_KEY=
CHATWOOT_ACTIVE_RECORD_SALT=
# 只有 HTTPS 入口启用后才改为 true。
CHATWOOT_FORCE_SSL=false

# Chatwoot 初始化完成后回填。
CHATWOOT_ACCOUNT_ID=
CHATWOOT_PLATFORM_TOKEN=
CHATWOOT_AGENT_PASSWORD=
CHATWOOT_WEBSITE_TOKEN=
