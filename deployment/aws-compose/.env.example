# This file is a strict render template. Installers must render every
# all double-underscore placeholder tokens with deployment-specific values before using Compose.
# Do not place plaintext credentials here; write the initial admin password
# to ADMIN_INITIAL_PASSWORD_FILE instead.
AWS_REGION=__AWS_REGION__
ECR_REGISTRY=__ECR_REGISTRY__
IMAGE_VERSION=__IMAGE_VERSION__
PUBLIC_BASE_URL=__PUBLIC_BASE_URL__
SERVER_SCHEME=__SERVER_SCHEME__
SERVER_HOST=__SERVER_HOST__
SERVER_AUTHZ_URL=__SERVER_AUTHZ_URL__
SERVER_MGT_URL=__SERVER_MGT_URL__
SERVER_MGT_API_URL=__SERVER_MGT_API_URL__
LOGIN_CAS_SERVER=__LOGIN_CAS_SERVER__
LOGIN_CAS_SERVICE=__LOGIN_CAS_SERVICE__
DATABASE_NAME=__DATABASE_NAME__
DATABASE_USER=__DATABASE_USER__
DATABASE_PWD=__DATABASE_PWD__
MYSQL_ROOT_PASSWORD=__MYSQL_ROOT_PASSWORD__
REDIS_PWD=__REDIS_PWD__
AUTH_JWT_SECRET=__AUTH_JWT_SECRET__
AUTH_JWT_REFRESH_SECRET=__AUTH_JWT_REFRESH_SECRET__
MGT_JWT_SECRET=__MGT_JWT_SECRET__
MGT_JWT_REFRESH_SECRET=__MGT_JWT_REFRESH_SECRET__
ADMIN_INITIAL_PASSWORD_FILE=/srv/maxkey/secrets/admin-initial-password
